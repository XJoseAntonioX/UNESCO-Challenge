{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug VERIFIBOT backend",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "cwd": "${workspaceFolder}/backend",
      "args": [
        "main:app",
        "--reload",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend"
      },
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "subProcess": true
    }
  ]
}
